# =============================================================================
# REQUIRED CONFIGURATION (for expense tracking)
# =============================================================================

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=

# AWS Bedrock API Key (get from AWS Console -> Bedrock -> API Keys)
# See: https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Receipt storage path (file-based storage)
RECEIPTS_STORAGE_PATH=./receipts_data

# Logging level (10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR)
LOGGING_LEVEL=20

# =============================================================================
# OPTIONAL CONFIGURATION (not needed for basic expense tracking)
# =============================================================================

# PostgreSQL Database (optional - currently using file storage)
# Uncomment and configure if you want to use database storage in the future
#POSTGRES_DATABASE=expense_tracker
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=
#POSTGRES_PORT=5432
#POSTGRES_HOST=localhost

# Redis Cache (optional - not currently used)
# Uncomment and configure if you want to add caching
#REDIS_DATABASE=1
#REDIS_HOST=localhost
#REDIS_PORT=6379
#REDIS_PASSWORD=

# Debug mode (optional)
#DEBUG=false
