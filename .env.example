# =============================================================================
# EXPENSE TRACKER BOT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# TELEGRAM BOT CONFIGURATION
# -----------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot and follow instructions
# 3. Copy the token provided
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Logging level (10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR)
LOGGING_LEVEL=20

# Debug mode (true/false)
DEBUG=false

# -----------------------------------------------------------------------------
# AWS BEDROCK CONFIGURATION (for AI Vision Model)
# -----------------------------------------------------------------------------
# AWS Bedrock API Key (simpler than IAM credentials)
# Get this from: AWS Console → Bedrock → API Keys → Generate API key
# Documentation: https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html
#
# For quick start: Generate a 30-day long-term key
# For production: Use short-term keys (12 hours max)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
AWS_REGION=us-east-1

# Note: Make sure you have enabled Claude 4 Sonnet model access in Bedrock
# Go to AWS Console → Bedrock → Model access → Request access

# -----------------------------------------------------------------------------
# STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
# Path where receipt JSON files will be stored
# Can be relative or absolute path
RECEIPTS_STORAGE_PATH=./receipts_data

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
# Currently not used for receipts, but available for future features
POSTGRES_DATABASE=expense_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432
POSTGRES_HOST=db

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
# Currently not used, but available for caching and session storage
REDIS_DATABASE=1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_USERNAME=
REDIS_TTL_STATE=
REDIS_TTL_DATA=

# =============================================================================
# QUICK SETUP CHECKLIST
# =============================================================================
# [ ] 1. Get Telegram bot token from @BotFather
# [ ] 2. Create AWS account and go to Bedrock console
# [ ] 3. Generate Bedrock API key (Long-term for testing, Short-term for prod)
# [ ] 4. Enable Claude 4 Sonnet model in Bedrock console
# [ ] 5. Fill in all values above
# [ ] 6. Save as .env (not .env.example)
# [ ] 7. Run: poetry install
# [ ] 8. Run: poetry run python -m src.bot
# =============================================================================

# =============================================================================
# AWS BEDROCK API KEY TYPES
# =============================================================================
# Long-term (30 days):
#   - Quick setup, no IAM configuration needed
#   - Perfect for testing and development
#   - Generate from: AWS Console → Bedrock → API Keys → Long-term
#
# Short-term (12 hours max):
#   - More secure for production
#   - Requires IAM principal with Bedrock permissions
#   - Auto-expires after session or 12 hours
#   - Generate from: AWS Console → Bedrock → API Keys → Short-term
#
# Documentation: https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html
# =============================================================================

# =============================================================================
# COST ESTIMATION
# =============================================================================
# AWS Bedrock Claude 4 Sonnet pricing (approximate):
# - Input: ~$3 per 1M tokens
# - Output: ~$15 per 1M tokens
# - Images: Additional cost per image
# 
# Estimated cost per receipt: ~$0.006
# Monthly cost (1000 receipts): ~$6
# =============================================================================

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - Never commit .env file to git (it's in .gitignore)
# - Use strong passwords for database and Redis
# - Rotate API keys regularly (especially long-term keys)
# - Use short-term API keys in production (12-hour expiration)
# - Long-term keys are for development/testing only
# - Enable AWS CloudTrail for audit logging
# - API keys are not logged in CloudTrail (passed as headers)
# =============================================================================
