# =============================================================================
# MINIMAL CONFIGURATION - Just what you need to get started!
# =============================================================================

# 1. Telegram Bot Token (get from @BotFather on Telegram)
BOT_TOKEN=your_bot_token_here

# 2. AWS Bedrock API Key (get from AWS Console -> Bedrock -> API Keys)
AWS_BEARER_TOKEN_BEDROCK=your_api_key_here
AWS_REGION=us-east-1

# 3. Storage path (where receipt JSON files will be saved)
RECEIPTS_STORAGE_PATH=./receipts_data

# 4. Logging level (20=INFO is good for normal use)
LOGGING_LEVEL=20

# =============================================================================
# That's it! You're ready to run the bot.
# =============================================================================
# Run: python -m src.bot
